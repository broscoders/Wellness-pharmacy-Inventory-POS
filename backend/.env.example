NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/wellness_pharmacy)
MONGODB_URI=mongodb://127.0.0.1:27017/wellness_pharmacy

# Only if you see "querySrv ETIMEOUT" when connecting: use Google/Cloudflare DNS for the Atlas lookup
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Used only by `npm run seed` to create the first owner account
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=owner@wellnesspharmacy.com
SEED_ADMIN_PASSWORD=ChangeMe@12345
